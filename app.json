{
  "expo": {
    "name": "Lắng Nghe Kinh Thánh",
    "slug": "audio-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-bible.png",
    "scheme": "audiobible",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.beken87.audio-bible",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "appleTeamId": "9GM5Y4Q89T"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/logo-bible.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.beken87.audiobible"
      ,"googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-bible.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundAudio": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng này truy cập vào ảnh của bạn để cho phép bạn cập nhật ảnh đại diện.",
          "cameraPermission": "Cho phép $(PRODUCT_NAME) sử dụng máy ảnh / thư viện ảnh",
          "//": "Disables the microphone permission",
          "microphonePermission": "Cho phép $(PRODUCT_NAME) sử dụng microphone",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
