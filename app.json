{
  "expo": {
    "name": "Lắng Nghe Kinh Thánh",
    "slug": "audio-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-bible.png",
    "scheme": "audiobible",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.beken87.audio-bible"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/logo-bible.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.beken87.audiobible"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-bible.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundAudio": true,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}